th 0.3) (type dash)) (fill (type none)) (uuid "5b24d06b-44f5-42f2-84e4-8bfeb79546f4")) (text "W5500-EVB-Pico-PoE (plugs into 2x 1x20 female headers)" (exclude_from_sim no) (at 22.86 55.88 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "b5cdfc64-c1ba-4622-b0c2-9daa73ff423d")) (text "GP16..GP21 are used by the on-board W5500 - do not use.\nGP27 (pin 32) = MAINS_OK input: HIGH = 230VAC present.\nGP4/GP5 = I2C0 SDA/SCL to TMP1075 (address 0x48).\n+3V3 comes from the module's 3V3(OUT) pin 36 (PoE powered)." (exclude_from_sim no) (at 22.86 158.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "342b0863-b34d-46c1-815c-437b6c9045f3")) (rectangle (start 20.32 182.88) (end 147.32 259.08) (stroke (width 0.3) (type dash)) (fill (type none)) (uuid "63f3aad7-8a18-416e-bfa7-ef90ab695d71")) (text "HAZARDOUS VOLTAGE - 230VAC MAINS SENSE" (exclude_from_sim no) (at 22.86 187.96 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "27e21388-7bc6-4809-8e91-38560e39947b")) (text "4x 68k 1206 (>=200V) split between L and N: ~1.2 mA peak, ~50 mW each.\nLTV-814S AC-input optocoupler, 5 kVrms. PCB: >=7.5 mm creepage + routed slot." (exclude_from_sim no) (at 22.86 254 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8d6deede-e69b-46fc-938d-b9e054c92a0e")) (rectangle (start 152.4 182.88) (end 330.2 259.08) (stroke (width 0.3) (type dash)) (fill (type none)) (uuid "f2984e01-38c8-4944-b121-4ff9e7a772bd")) (text "Mains detect + LED indication (works without firmware)" (exclude_from_sim no) (at 154.94 187.96 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "d67411d4-1700-426b-ad3a-74fa1b902319")) (text "Opto pulls SENSE low while mains is present; C1 holds it low over the zero crossings (47k x 1uF = 47 ms).\nMAINS_OK = NOT SENSE: green LED on = mains ON, red LED on = mains OFF." (exclude_from_sim no) (at 154.94 254 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d997dbcb-a194-4c1f-ba86-74c88d8a97ef")) (rectangle (start 254 76.2) (end 365.76 137.16) (stroke (width 0.3) (type dash)) (fill (type none)) (uuid "b49f0751-752c-43ce-a211-570181481620")) (text "Temperature sensor TMP1075 (I2C 0x48, +-1 C)" (exclude_from_sim no) (at 256.54 81.28 0) (effects (font (size 2 2) (bold yes)) (justify left bottom)) (uuid "1f56f602-4a6e-4105-ba52-9871bd514c4a")) (text "Placed away from the module and the mains resistors.\nALERT not used." (exclude_from_sim no) (at 256.54 132.08 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "20765c58-c66f-4a57-b9dc-f8f84207d5d0")) (sheet_instances (path "/" (page "1"))) (embedded_fonts no))
